# LensQR Photo & Video QR Generator Environment Variables

# Flask secret key for CSRF and session cookies (generate a secure random string in production)
SECRET_KEY=lensqr-secret-dev-key-change-in-production-8f92a3bc

# Brand display name
BRAND_NAME=LensQR

# Public URL Configuration
# Set PUBLIC_URL to your Cloudflare Tunnel HTTPS URL (e.g. https://xxxx.trycloudflare.com)
# or your custom domain (e.g. https://qr.yourdomain.com).
# This public HTTPS URL is encoded into QR codes so people from Punjab, mobile 4G/5G,
# and anywhere globally can scan and open photos and videos.
PUBLIC_URL=
DEV_PUBLIC_URL=

# Host and Port binding (default: 0.0.0.0 and 5000)
HOST=0.0.0.0
PORT=5000

# Flask debug mode (default: False; keep False when exposed publicly to protect secret keys)
FLASK_DEBUG=False

# Upload size limits (in Megabytes)
MAX_PHOTO_MB=25
MAX_VIDEO_MB=100

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Supabase project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase backend Service Role Key (Keep secret! Only used on Flask backend)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Supabase Publishable / Anon Key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Storage bucket name for photos, videos, and QR codes (default: qr-media)
SUPABASE_STORAGE_BUCKET=qr-media

# Expiration time for signed private media URLs in seconds (default: 3600 = 1 hour)
SIGNED_URL_EXPIRY=3600

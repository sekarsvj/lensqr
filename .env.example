# LensQR Photo & Video QR Generator Environment Variables

# Flask secret key for CSRF and session cookies (generate a secure random string in production)
SECRET_KEY=lensqr-secret-dev-key-change-in-production-8f92a3bc

# Brand display name
BRAND_NAME=LensQR

# Public URL (Optional)
# If hosted behind a domain, reverse proxy, or tunnel (e.g. https://qr.lensqr.net),
# specify it here. When set, all generated QR codes will encode this public URL.
# If left empty, the generator automatically uses the incoming request host URL.
PUBLIC_URL=

# Upload size limits (in Megabytes)
MAX_PHOTO_MB=25
MAX_VIDEO_MB=100
